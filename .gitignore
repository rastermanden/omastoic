node_modules/
.host/

# `.agents/skills` is the canonical skills directory, committed and shared by
# every coding agent. It stays out of the installed plugin via `.gitattributes`
# export-ignore and `install.sh` --exclude, not via this ignore.

# Commons sources are re-downloadable, so they stay out of the repo.
# assets/local/ is deliberately NOT ignored: those images cannot be
# fetched from anywhere, and art/ could not be rebuilt without them.
assets/sources/
assets/originals/
*.bak.*

# Motion lives on GitHub releases, not in the plugin clone.
demo.mp4
preview.gif
